{
  "name": "psd-bridge",
  "version": "0.9.0",
  "private": true,
  "description": "Figma plugin that imports a prepped PSD as a layered, editable frame.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "node scripts/inspect-psd.mjs",
    "fixture": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "ag-psd": "^31.0.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
